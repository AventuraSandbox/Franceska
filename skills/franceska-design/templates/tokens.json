{
  "name": "{{app}} design tokens",
  "colors": {
    "bg": "#ffffff", "surface": "#f6f7f9", "border": "#d7dbe0", "border-input": "#8a93a0",
    "text": "#14181f", "text-muted": "#4a5260", "accent": "#2f5bd8", "on-accent": "#ffffff",
    "danger": "#b42318", "success": "#067647", "warning": "#8a5a00"
  },
  "colors_dark": {
    "bg": "#0f1217", "surface": "#171b22", "border": "#2c333d", "border-input": "#7b8594",
    "text": "#f1f3f6", "text-muted": "#aab2bf", "accent": "#7d9bff", "on-accent": "#0f1217",
    "danger": "#ff8a80", "success": "#5fd39a", "warning": "#f2b84b"
  },
  "pairs": [
    {"fg": "text", "bg": "bg", "min": 4.5, "label": "body"},
    {"fg": "text", "bg": "surface", "min": 4.5, "label": "body on card"},
    {"fg": "text-muted", "bg": "bg", "min": 4.5, "label": "secondary text"},
    {"fg": "on-accent", "bg": "accent", "min": 4.5, "label": "primary button"},
    {"fg": "accent", "bg": "bg", "min": 4.5, "label": "links"},
    {"fg": "danger", "bg": "bg", "min": 4.5, "label": "error text"},
    {"fg": "border-input", "bg": "bg", "min": 3.0, "label": "input border"},
    {"fg": "accent", "bg": "bg", "min": 3.0, "label": "focus ring"}
  ],
  "type": {
    "font-sans": "Inter, system-ui, sans-serif",
    "scale": {"xs": [12, 16], "sm": [14, 20], "md": [16, 24], "lg": [20, 28], "xl": [28, 36], "2xl": [40, 48]},
    "weights": {"regular": 400, "medium": 500, "semibold": 600}
  },
  "spacing": {"base": 4, "scale": [0, 4, 8, 12, 16, 24, 32, 48, 64]},
  "radius": {"sm": 4, "md": 8, "lg": 12, "full": 9999},
  "shadow": {"sm": "0 1px 2px rgba(0,0,0,.08)", "md": "0 4px 12px rgba(0,0,0,.12)"},
  "layout": {"max-width": 1120, "header-height": 56, "sidebar-width": 240, "breakpoints": [640, 960, 1280]}
}
